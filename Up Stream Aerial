.portfolio-card, .service-card, .button { transition: .25s ease; }

@media (max-width: 900px) {
  .menu-button { display: block; }
  .site-nav {
    display: none;
    position: absolute;
    top: 70px;
    left: 16px;
    right: 16px;
    padding: 22px;
    flex-direction: column;
    align-items: stretch;
    background: #071726;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 16px;
  }
  .site-nav.open { display: flex; }
  .hero { grid-template-columns: 1fr; padding-top: 140px; }
  .hero-card { justify-self: start; width: min(100%, 480px); transform: none; }
  .intro, .about, .contact-section { grid-template-columns: 1fr; }
  .service-grid { grid-template-columns: 1fr 1fr; }
  .process-grid { grid-template-columns: 1fr; }
}

@media (max-width: 650px) {
  .section { padding: 75px 20px; }
  .site-header { padding: 14px 18px; }
  .brand small { display: none; }
  .hero { padding: 125px 20px 78px; min-height: auto; }
  .hero h1 { font-size: 52px; }
  .section-heading { align-items: start; flex-direction: column; }
  .portfolio-grid { grid-template-columns: 1fr; }
  .portfolio-one, .portfolio-four { grid-column: auto; grid-row: auto; min-height: 390px; }
  .service-grid { grid-template-columns: 1fr; }
  .about-visual { min-height: 420px; }
  .contact-form { grid-template-columns: 1fr; }
  .contact-form label { grid-column: 1 / -1; }
  footer { flex-direction: column; align-items: flex-start; }
}
