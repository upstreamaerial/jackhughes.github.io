.about-badge strong, .about-badge span { display: block; }
.about-badge strong { font-size: 28px; }
.about-badge span { color: rgba(255,255,255,.65); font-size: 12px; }
.about-copy p { color: var(--muted); }
.check-list { list-style: none; padding: 0; margin: 28px 0 0; }
.check-list li { padding: 12px 0; border-bottom: 1px solid var(--line); font-weight: 700; }
.check-list li::before { content: "✓"; margin-right: 12px; color: #2c7590; }

.process { background: #e9ece8; }
.process-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.process-grid > div { padding: 30px; border-top: 1px solid var(--ink); }
.process-grid span { font-size: 12px; font-weight: 800; color: #2c7590; }
.process-grid h3 { font-size: 22px; }
.process-grid p { color: var(--muted); }

.contact-section {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: 7vw;
  padding: 110px clamp(24px, 7vw, 110px);
  color: white;
  background: linear-gradient(145deg, #071726, #0d3347);
}
.contact-section > div > p { color: rgba(255,255,255,.65); max-width: 580px; }
.contact-details { display: grid; gap: 10px; margin-top: 34px; }
.contact-details a { color: white; text-decoration: none; }
.contact-details span { color: rgba(255,255,255,.55); }

.contact-form {
